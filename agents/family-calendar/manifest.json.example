{
  "agent_id": "family-calendar",
  "display_name": "Mistress Mouse",
  "workspace": "~/.clawford/family-calendar-workspace",
  "telegram": {
    "account": "familycal",
    "bot_token_env": "FAMILYCAL_BOT_TOKEN"
  },
  "config_files": [],
  "scripts": [
    "scripts/gcal-fetch.py",
    "scripts/gcal-auth.py",
    "scripts/gcal-write.py",
    "scripts/reminder-check.py",
    "scripts/timed-deliver.py",
    "scripts/activity-email-check.py",
    "scripts/gmail-invite-check.py",
    "scripts/chat-parse-schedule.py",
    "scripts/heartbeat.py",
    "scripts/calendar-index-build.py",
    "scripts/gcal-tasks-sync.py",
    "scripts/morning-briefing.py",
    "scripts/activity-email-alert.py",
    "scripts/gmail-invite-alert.py",
    "scripts/whatsapp-chat-alert.py",
    "scripts/whatsapp-schedule-post.py"
  ],
  "state_files": [
    {
      "path": "sent-reminders.json",
      "seed_if_absent": {
        "reminders": {},
        "last_pruned": null
      }
    },
    {
      "path": "calendar-config.json",
      "seed_if_absent": {
        "calendars": [
          {
            "id": "sam.smith@example.com",
            "label": "Sam",
            "emoji": "👨"
          },
          {
            "id": "alex.rivera@example.com",
            "label": "Alex",
            "emoji": "👩"
          }
        ],
        "timezone": "America/Los_Angeles",
        "activity_providers": [
          {
            "name": "Example Preschool",
            "query": "from:ExamplePreschool newer_than:2d"
          },
          {
            "name": "Example Swim School",
            "query": "from:ExampleSwim newer_than:2d"
          },
          {
            "name": "Example Ballet Studio",
            "query": "from:ExampleBallet newer_than:2d"
          }
        ]
      }
    }
  ],
  "approvals": {
    "allowlist": [
      "/usr/bin/*",
      "/bin/*",
      "/usr/local/bin/*"
    ]
  },
  "crons": [
    {
      "name": "morning-briefing",
      "cron": "30 10 * * *",
      "message": "DISABLED — replaced by ops/scripts/install-host-cron.sh entry family-calendar-morning-briefing, which runs agents/family-calendar/scripts/morning-briefing.py on host cron at 30 10 * * * (writes cache/morning-brief-ready.txt for the 5 AM PT fleet delivery; appends a weekly-overview section on Mondays). Kept here for Phase 4 rollback reference.",
      "announce": false,
      "no_deliver": true,
      "enabled": false
    },
    {
      "name": "activity-email-alert",
      "cron": "15 */2 * * *",
      "message": "DISABLED — replaced by ops/scripts/install-host-cron.sh entry family-calendar-activity-email-alert, which runs agents/family-calendar/scripts/activity-email-alert.py on host cron at 15 */2 * * * (LLM classifies provider emails, sends per-item Telegram alerts). Kept here for Phase 4 rollback reference.",
      "announce": false,
      "no_deliver": true,
      "enabled": false
    },
    {
      "name": "gmail-invite-alert",
      "cron": "30 */3 * * *",
      "message": "DISABLED — replaced by ops/scripts/install-host-cron.sh entry family-calendar-gmail-invite-alert, which runs agents/family-calendar/scripts/gmail-invite-alert.py on host cron at 30 */3 * * * (formats + sends per-invite Telegram alerts). Kept here for Phase 4 rollback reference.",
      "announce": false,
      "no_deliver": true,
      "enabled": false
    },
    {
      "name": "weekly-overview",
      "cron": "0 1 * * 0",
      "message": "DISABLED — Option C, folded into morning-briefing.py on Mondays. The 5 AM PT Monday brief now includes a WEEK AHEAD section populated from gcal-fetch --days 7. No separate cron needed. Kept here for Phase 4 rollback reference.",
      "announce": true,
      "no_deliver": false,
      "enabled": false
    }
  ]
}