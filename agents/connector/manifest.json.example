{
  "agent_id": "connector",
  "display_name": "Huckle Cat",
  "workspace": "~/.openclaw/connector-workspace",
  "status_file": "~/Dropbox/openclaw-backup/agents/connector.status.md",
  "telegram": {
    "account": "huckle",
    "bot_token_env": "CONNECTOR_BOT_TOKEN"
  },
  "config_files": [
    {
      "src": "SOUL.md",
      "immutable": true
    },
    {
      "src": "IDENTITY.md",
      "immutable": true
    },
    {
      "src": "TOOLS.md"
    },
    {
      "src": "AGENTS.md"
    },
    {
      "src": "USER.md"
    },
    {
      "src": "HEARTBEAT.md"
    },
    {
      "src": "MEMORY.md"
    }
  ],
  "scripts": [
    "scripts/people-scan.py",
    "scripts/notes-triage.py",
    "scripts/commitment-scan.py",
    "scripts/timed-deliver.py",
    "scripts/heartbeat.py",
    "scripts/daily-refresh.py"
  ],
  "state_files": [
    {
      "path": "pending-triage.json",
      "seed_if_absent": {
        "pending": {},
        "last_pruned": null
      }
    },
    {
      "path": "checkin-log.json",
      "seed_if_absent": {
        "checkins": []
      }
    },
    {
      "path": "connector-config.json",
      "seed_if_absent": {
        "cadences": {
          "family-inner": {
            "check_days": 1,
            "nudge": false,
            "note": "Monitored by Mistress Mouse"
          },
          "family-extended": {
            "check_days": 21,
            "nudge": true
          },
          "friends-close": {
            "check_days": 30,
            "nudge": true
          },
          "professional-inner": {
            "check_days": 7,
            "nudge": true
          },
          "professional-outer": {
            "check_days": 90,
            "nudge": true
          },
          "holiday-card": {
            "check_days": 365,
            "nudge": false,
            "note": "Life events only"
          }
        },
        "timezone": "America/Los_Angeles",
        "nudge": {
          "max_per_day": 5,
          "skip_circles": [
            "family-inner",
            "holiday-card"
          ]
        },
        "triage": {
          "max_batch_size": 10,
          "categories": [
            "fact",
            "commitment",
            "task",
            "shopping",
            "unclear"
          ]
        }
      }
    }
  ],
  "approvals": {
    "policy": "full",
    "security": "full",
    "allowlist": [
      "/usr/bin/*",
      "/bin/*",
      "/usr/local/bin/*",
      "python3 ~/.openclaw/connector-workspace/scripts/*",
      "python3 -"
    ]
  },
  "crons": [
    {
      "name": "daily-refresh",
      "cron": "30 11 * * *",
      "message": "\u26a1 EXEC DISCIPLINE: run any `python3 <path>` command exactly as written \u2014 a bare invocation, nothing appended, no shell wrapping, no chaining with other commands, no output redirection, no exit-code capture. Scripts always print one JSON line to stdout with a `status` field (ok/error/degraded); parse that final line to decide what to do. Refresh last_interaction across ~/Dropbox/openclaw-backup/people/*.md by re-mining the past 14 days of Gmail, Google Calendar, and Krisp transcripts, and write the next 14 days of upcoming GCal attendees to upcoming-meetings.json so people-scan can demote people you already have on the calendar. Run: python3 ~/.openclaw/connector-workspace/scripts/daily-refresh.py. Parse the JSON from stdout. If status is 'ok' or 'degraded' with people_updated > 0, return EXACTLY the empty string (zero bytes, no narration, no acknowledgement). If status is 'error' or the alert field is set, deliver a short Telegram message describing the failure so the operator knows the refresh is broken. DO NOT touch ~/Dropbox/openclaw-backup/agents/connector.status.md \u2014 fleet-health.json owns health.",
      "announce": false,
      "no_deliver": true
    },
    {
      "name": "morning-relationship-nudge",
      "cron": "50 11 * * *",
      "message": "\u26a1 EXEC DISCIPLINE: run any `python3 <path>` command exactly as written \u2014 a bare invocation, nothing appended, no shell wrapping, no chaining with other commands, no output redirection, no exit-code capture. Scripts always print one JSON line to stdout with a `status` field (ok/error/degraded); parse that final line to decide what to do. openclaw 2026.4.11 rejects complex shell invocations before they run. Generate and deliver the morning relationship nudge. 1) Run: python3 ~/.openclaw/connector-workspace/scripts/people-scan.py. Read the JSON output \u2014 it contains overdue, approaching, and healthy contacts with their check-in status. 2) Format the nudge using the template in CRONS.md. Group by overdue then approaching. Include each person's name, relationship, days since last contact, and preferred channel. 3) If no overdue or approaching: use the 'everyone accounted for' template. 4) Write formatted output to cache/morning-nudge.txt. 5) Run: python3 ~/.openclaw/connector-workspace/scripts/timed-deliver.py cache/morning-nudge.txt --token-env CONNECTOR_BOT_TOKEN. 6) DO NOT touch ~/Dropbox/openclaw-backup/agents/connector.status.md \u2014 fleet-health.json (R6 orchestrator) is the authoritative health source.",
      "announce": false,
      "no_deliver": true
    },
    {
      "name": "notes-triage",
      "cron": "0 8,20 * * *",
      "message": "\u26a1 EXEC DISCIPLINE: run any `python3 <path>` command exactly as written \u2014 a bare invocation, nothing appended, no shell wrapping, no chaining with other commands, no output redirection, no exit-code capture. Scripts always print one JSON line to stdout with a `status` field (ok/error/degraded); parse that final line to decide what to do. openclaw 2026.4.11 rejects complex shell invocations before they run. Triage untriaged notes from the inbox. Run: python3 ~/.openclaw/connector-workspace/scripts/notes-triage.py. Read the JSON output. If no untriaged notes, return EXACTLY the empty string (zero bytes, no narration \u2014 not even \"NO output\", \"Done\", \"all clear\", or a status summary). Any text you emit is logged and charges tokens even when no Telegram message is sent. If untriaged notes exist: read pending-triage.json to skip already-presented notes. For each new note, categorize it (fact/commitment/task/shopping/unclear). Present up to 10 on Telegram with categories and '/confirm to save \u00b7 /dismiss N to skip item N'. Record presented note IDs in pending-triage.json.",
      "announce": false,
      "no_deliver": true
    },
    {
      "name": "weekly-review",
      "cron": "0 0 * * 0",
      "message": "\u26a1 EXEC DISCIPLINE: run any `python3 <path>` command exactly as written \u2014 a bare invocation, nothing appended, no shell wrapping, no chaining with other commands, no output redirection, no exit-code capture. Scripts always print one JSON line to stdout with a `status` field (ok/error/degraded); parse that final line to decide what to do. openclaw 2026.4.11 rejects complex shell invocations before they run. Generate the weekly relationship review. 1) Run people-scan.py to get current check-in state. 2) Read checkin-log.json for this week's check-ins. 3) Compile: check-ins recorded, notes triaged, facts added, people tracked, still-overdue contacts. 4) Format using the template in CRONS.md. 5) Deliver to Telegram.",
      "announce": true,
      "no_deliver": false
    }
  ]
}
