  "fix-it": {
    "cron-self-check": {
      "cron": "0 0 * * *",
      "no_deliver": true,
      "announce": false,
      "account": "default",
      "to": "111111111",
      "message": "Run: openclaw cron list. Verify all 9 fix-it LLM crons are registered (cron-self-check, brain-validation, conflict-scan, file-size-monitor, obsidian-briefing, monthly-archival, security-audit, update-check, probation-end-reminder). Host crons (fleet-health, morning-status, reminder-check, engagement-poll, costco-token-refresh, morning-fleet-deliver, linkedin-keepalive) live in the system crontab via install-host-cron.sh and are NOT in scope — do not re-register them even if they look missing from openclaw cron list. Filter the output visually for fix-it entries. If all 9 are present: produce NO output and DO NOT touch fix-it.status.md (fleet-health is the only writer). If any are missing: attempt to re-register them and send me a Telegram message."
    },
    "conflict-scan": {
      "cron": "0 */2 * * *",
      "no_deliver": true,
      "announce": false,
      "account": "default",
      "to": "111111111",
      "message": "Run: find ~/Dropbox/openclaw-backup/ -name *conflicted copy* -type f. If NO conflicts found: produce NO output and DO NOT touch ~/Dropbox/openclaw-backup/agents/fix-it.status.md — fleet-health.json (R6 orchestrator) is the authoritative health source. If conflicts ARE found: send me a Telegram message with the filenames. Do NOT attempt to merge."
    },
    "brain-validation": {
      "cron": "0 */6 * * *",
      "no_deliver": true,
      "announce": false,
      "account": "default",
      "to": "111111111",
      "message": "Run: python3 ~/Dropbox/openclaw-backup/scripts/validate.py. If validation PASSES: produce NO output and DO NOT touch ~/Dropbox/openclaw-backup/agents/fix-it.status.md — fleet-health.json (R6 orchestrator) is the authoritative health source. If validation FAILS: send me a Telegram message with the specific failures immediately."
    },
    "security-audit": {
      "cron": "0 4 * * 0",
      "no_deliver": false,
      "announce": true,
      "account": "default",
      "to": "111111111",
      "message": "Run: python3 /home/openclaw/.clawford/fix-it-workspace/scripts/security-audit.py\n\nThe script reads /home/openclaw/.clawford/exec-approvals.json directly, runs openclaw security audit --deep, applies enrichment rules (suppresses tools.exec.security_full_configured and plugins.tools_reachable_permissive_policy), and prints the formatted emoji-headed severity report. Send the entire stdout to Telegram as ONE message. Do NOT use python3 -c. Do NOT use heredocs. Do NOT regenerate the report yourself — just run the script and forward its output verbatim."
    },
    "probation-end-reminder": {
      "cron": "0 16 25 4 *",
      "no_deliver": false,
      "announce": true,
      "account": "default",
      "to": "111111111",
      "message": "🦊🔧 Probation review reminder. Today is 2026-04-25 — your 14-day probation window ends today. Read ~/Dropbox/openclaw-backup/fix-it/probation.md for the failure ledger Sam has been keeping. Send Sam one Telegram message: 'Probation ends today. Failures logged: {N}. Verdict requested: keep / extend / retire.' Then stop. Do not propose a verdict yourself — that is Sam's decision. Retirement command if needed: bash ~/repo/agents/fix-it/retire.sh"
    },
    "file-size-monitor": {
      "cron": "0 12 * * *",
      "no_deliver": true,
      "announce": false,
      "account": "default",
      "to": "111111111",
      "message": "Run: find ~/Dropbox/openclaw-backup/ -type f -size +500k. If NO large files found: produce NO output and DO NOT touch ~/Dropbox/openclaw-backup/agents/fix-it.status.md — fleet-health.json (R6 orchestrator) is the authoritative health source. If large files ARE found: send me a Telegram message with the filenames and sizes."
    },
    "obsidian-briefing": {
      "cron": "10 12 * * *",
      "no_deliver": true,
      "announce": false,
      "account": "default",
      "to": "111111111",
      "message": "Generate daily Obsidian briefing. Run: python3\n~/Dropbox/openclaw-backup/scripts/obsidian-briefing/generate.py. If successful: produce NO output. DO NOT touch ~/Dropbox/openclaw-backup/agents/fix-it.status.md — fleet-health.json (R6 orchestrator) is the authoritative health source. If it fails: report the error."
    },
    "update-check": {
      "cron": "0 4 * * 3",
      "no_deliver": false,
      "announce": true,
      "account": "default",
      "to": "111111111",
      "message": "Run: openclaw update. Report current version and whether an update is available on Telegram. Do NOT apply updates automatically. Wait for my confirmation."
    },
    "monthly-archival": {
      "cron": "0 3 1 * *",
      "no_deliver": false,
      "announce": true,
      "account": "default",
      "to": "111111111",
      "message": "Run monthly archival. Create /home/node/Dropbox/openclaw-backup/archive/YYYY-MM/ for current month. Scan ALL files matching /home/node/Dropbox/openclaw-backup/facts/*.md (every monthly file, not just the current month). For each fact entry, calculate effective_confidence = original_confidence * 0.5^(days_since_recorded / half_life) using category half-lives: identity=never, established=365, situation=90, preference=180, plan=30, logistics=7, rumor=14. Move facts with effective_confidence < 0.2 AND recorded > 90 days ago to the archive. Also scan /home/node/Dropbox/openclaw-backup/tasks/queue.md and move tasks with status done and completed > 90 days ago. Write an archive manifest listing everything moved. Report results on Telegram."
    }
  },
  "family-calendar": {}
}