# TOTP / channel bot config inline — NEVER commit them.)
ops/.env
ops/secrets.env
ops/config/openclaw.json

# Large binaries
*.pdf

# OS files
desktop.ini
.DS_Store
Thumbs.db

# Dropbox
*conflicted copy*

# Cloned repos (managed separately)
infra/
openclaw-docker-config/

# Backups
*.tar.gz

# MkDocs build artifacts
/site/
/_site_src/

# Cloudflare Wrangler cache (populated by `npx wrangler pages deploy`)
.wrangler/

# Python
__pycache__/
*.pyc

# Google OAuth secrets
credentials.json
token.json

# Local Claude Code harness state (settings + lock). Skills are tracked.
.claude/*
!.claude/skills/

# === PII remediation (2026-04) ===
# Agent config / identity / state files hold real names, DOBs, emails,
# calendar IDs, and similar. Only the *.example templates are tracked;
# the real unsuffixed files live on the operator's working tree only.
# On a fresh clone, run:
#   python3 agents/shared/deploy.py <agent> --bootstrap-configs
# to scaffold the real files from their .example siblings. .md files get
# a CLAWFORD_BOOTSTRAP_UNEDITED sentinel comment that deploy.py refuses
# until you replace the dummy values and delete the sentinel line.
# SOUL.md / IDENTITY.md / USER.md / AGENTS.md / MEMORY.md moved from
# agents/<agent>/ to ~/Dropbox/openclaw-backup/agents/<agent>/ in 2026-04.
# Still gitignored as a safety net in case stray copies appear.
agents/*/AGENTS.md
agents/*/IDENTITY.md
agents/*/MEMORY.md
agents/*/SOUL.md
agents/*/USER.md
agents/*/manifest.json
agents/family-calendar/calendar-config.json
agents/connector/connector-config.json
agents/meetings-coach/meeting-config.json
agents/fix-it/expected-crons.json
agents/fix-it/KNOWN_ISSUES.md
agents/fix-it/probation.md
agents/connector/scripts/mine/family_map.py
agents/connector/scripts/mine/mining-config.json
